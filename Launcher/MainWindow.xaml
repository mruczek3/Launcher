<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Old SCP:SL Launcher" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#0D0F1A">

    <Grid>
        <!-- Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1F3C" Offset="0"/>
                <GradientStop Color="#0D0F1A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <DockPanel>
            <!-- Sidebar -->
            <StackPanel DockPanel.Dock="Left" Width="200" Background="#141823">

                <!-- HEADER Z LOGO + NAPIS -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,30,0,20">
                    <Image x:Name="LogoImage"
                           Source="Images/logoo.png"
                           Width="40" Height="40"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                    </Image>

                    <TextBlock x:Name="LauncherTitle"
                               Text="Launcher"
                               Foreground="White"
                               FontSize="22" FontWeight="Bold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#5B86FF" BlurRadius="15" ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <Button Content="Wersje" Style="{StaticResource NavButtonStyle}" Margin="10" Click="ShowDownloadPage"/>
                <Button Content="Graj" Style="{StaticResource NavButtonStyle}" Margin="10" Click="ShowPlayPage"/>
                <Button Content="Zamknij" Style="{StaticResource NavButtonStyle}" Margin="10" Click="CloseApp"/>
                <TextBlock Text="5.0.0-alpha2"
                           Foreground="DarkGray"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>

            <!-- Główne zakładki -->
            <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <!-- Ukrycie zakładek -->
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- STRONA WERSJE -->
                <TabItem>
                    <ScrollViewer Margin="20">
                        <StackPanel>
                            <TextBlock Text="Dostępne wersje" 
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       Margin="0,0,0,20"/>

                            <!-- Wersja 9.1.3 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="9.1.3 (Megapatch 2)" Foreground="LightGray" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Pobierz"
                                                Tag="9.1.3|https://download1076.mediafire.com/486s3ld31icgQOzxyclw4hOmxJ0-qB53wkYDJnmRxh6Kz6hkFHMr1PS99VfNjqN-jC4UA-LHYe9LZyv4HCxRgiKu2KlEorMhFryfSKi9moKS71shBu2asPQaiJcK-l-8QqPlRL8ws8PBc1GKmmLNAoJAzYOaRkDDTgcaD-hVHZel/76iaewr4xx99vjt/Cichaczownia+Event.zip"
                                                Click="DownloadButton_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Width="120" Height="40"
                                                Margin="0,0,10,0"/>
                                        <Button Content="Anuluj"
                                                Click="CancelDownload_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Width="120" Height="40"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Wersja 10.1.3 -->
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Scopophobia Halloween" Foreground="Orange" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Pobierz"
                                                Tag="10.0.5|https://www.dropbox.com/scl/fi/hiiurjwq1sr1uijgwnp0s/Cichaczownia-Event.zip?rlkey=kxztt0276fkqk0sfu9smo4q4a&amp;st=wkd74zwx&amp;dl=1"
                                                Click="DownloadButton_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Width="120" Height="40"
                                                Margin="0,0,10,0"/>
                                        <Button Content="Anuluj"
                                                Click="CancelDownload_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Width="120" Height="40"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Pasek postępu -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                                <StackPanel>
                                    <ProgressBar x:Name="DownloadProgress" Height="18" Minimum="0" Maximum="100"
                                                 Foreground="#5B86FF" Background="#2A2E3D"/>
                                    <TextBlock x:Name="DownloadStatus" Text="Oczekiwanie..."
                                               Foreground="LightGray"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- STRONA GRAJ -->
                <TabItem>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Wybierz wersję do uruchomienia" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ComboBox x:Name="InstalledVersions" Width="250" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="▶ Graj"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Width="140" Height="45"
                                    Margin="0,0,10,0"
                                    Click="PlayButton_Click"/>
                            <Button Content="🗑 Odinstaluj"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Width="140" Height="45"
                                    Click="UninstallButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Toast na błędy/info -->
        <Border x:Name="Toast" CornerRadius="8"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,20"
                Padding="12" Visibility="Collapsed" Opacity="0">
            <TextBlock x:Name="ToastText" Foreground="White" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>
